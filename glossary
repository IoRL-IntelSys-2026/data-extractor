from dataclasses import dataclass, field
from typing import List, Optional

@dataclass
class TermEntry:
    means: str                     # Основное значение
    abbr: bool = False             # Является ли аббревиатурой
    ambiguous: bool = False        # Есть ли другие значения
    alternatives: List[str] = field(default_factory=list) # Другие значения, если ambiguous=True

